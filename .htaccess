<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hostinger may deploy the repository directly into the domain root.
    # Keep Laravel's private files outside the web entry point by routing all
    # requests through the public directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
